# LLM — OpenAI-совместимый endpoint (httpx, без SDK). Сейчас за ним Gemini.
GEMINI_API_KEY=your_gemini_api_key
LLM_MODEL=gemini-2.0-flash
LLM_CLASSIFIER_MODEL=gemini-2.0-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Прокси для доступа к LLM API из контейнера (опционально).
# host.docker.internal указывает на хост-машину из контейнера.
# GEMINI_PROXY=http://host.docker.internal:10801

# Database
POSTGRES_PASSWORD=your_password

# Embeddings
EMBEDDINGS_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Ingestion
CONFIDENCE_THRESHOLD=0.7          # минимальный confidence для связей
MERGE_THRESHOLD=0.85              # порог сходства для merge сущностей (внутри типа)
MAX_CHAPTER_TOKENS=4000           # максимум токенов на главу для LLM

# GraphRAG
GRAPHRAG_MAX_ENTITIES=15          # бюджет сущностей в контексте ответа
ENTITY_LINK_THRESHOLD=0.6         # порог привязки вопроса к сущности

# Test generation / progress
QUESTIONS_PER_CONCEPT=3
LEARNED_SCORE_THRESHOLD=0.7       # минимальный score для статуса "learned"
